# --- WhatsApp ---
# WHATSAPP_NUMBER alone gives you click-to-chat (the WhatsApp button
# customers can click) — works with zero extra setup.
#
# To also get AUTOMATIC WhatsApp alerts pushed to that same number whenever
# a customer places an order or a payment comes in (so staff see it even
# when not logged into the dashboard), you additionally need
# WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID from a Meta WhatsApp
# Business Cloud API app. Without those two, order/payment alerts are
# silently skipped — nothing breaks, you just don't get the WhatsApp ping.
# WHATSAPP_VERIFY_TOKEN is only needed if you also want inbound WhatsApp
# messages logged as leads via /webhooks/whatsapp.
WHATSAPP_NUMBER=237672789456
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Social media (optional — the icon for each only shows in the footer
#     once you set its URL; leave blank to hide it) ---
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_X_URL=
SOCIAL_TIKTOK_URL=

# --- AI customer support (optional — the chat widget works with a
